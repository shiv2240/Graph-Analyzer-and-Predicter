# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ─── Backend ─────────────────────────────────────────────────────────────────
BACKEND_PORT=3001
BACKEND_HOST=0.0.0.0

# ─── AI Service ──────────────────────────────────────────────────────────────
AI_SERVICE_PORT=8000
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_URL=http://ai-service:8000      # internal Docker network name

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=stockintel
POSTGRES_USER=stockintel
POSTGRES_PASSWORD=changeme_strong_password
DATABASE_URL=postgresql://stockintel:changeme_strong_password@postgres:5432/stockintel

# ─── Market Data Providers ───────────────────────────────────────────────────
# yfinance: no key required; subject to Yahoo Finance terms of use
YFINANCE_ENABLED=true

# Alpha Vantage: free tier, 25 req/day (standard key), 500 req/day (premium)
# Register: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=DEMO

# Finnhub: free tier, 60 req/min, US equities
# Register: https://finnhub.io/register
FINNHUB_API_KEY=

# Upstox Developer API: Indian market data (NSE/BSE)
# Register: https://upstox.com/developer/
# Requires brokerage account + OAuth2 flow
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:3001/auth/upstox/callback
UPSTOX_ACCESS_TOKEN=        # set after OAuth handshake

# ─── AI / LLM ─────────────────────────────────────────────────────────────────
# Google Gemini: free tier available
# Register: https://ai.google.dev/
GEMINI_API_KEY=

# Hugging Face: free inference for public models
# Register: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# ─── Frontend (build-time, injected as VITE_ prefix) ──────────────────────────
# NEVER put secrets here — these values are bundled into the browser JS
VITE_BACKEND_URL=http://localhost:3001
VITE_APP_TITLE=Stock Intelligence AI

# ─── Rate Limiting ───────────────────────────────────────────────────────────
PROVIDER_REQUEST_TIMEOUT_MS=10000
CACHE_TTL_SECONDS=300
